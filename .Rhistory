(1 - alpha)^(ncol(M) - k) *
(1 - alpha)
}
for (k in seq_len(ncol(M))) {
y <- y + M[2, k] *
choose(ncol(M) - 1, k - 1) *
alpha^(k - 1) *
(1 - alpha)^(ncol(M) - k) *
alpha
}
y
}
y.bar.margin <- function(PO, alpha) {
y <- 0
for (i in seq_len(n)) {
y <- y + y.bar.ind.margin(PO, i, alpha)
}
y / n
}
DE_true <- function(PO, alpha) {
y.bar(PO, 1, alpha) - y.bar(PO, 0, alpha)
}
IE_true <- function(PO, alpha1, alpha0) {
y.bar(PO, 0, alpha1) - y.bar(PO, 0, alpha0)
}
TE_true <- function(PO, alpha1, alpha0) {
y.bar(PO, 1, alpha1) - y.bar(PO, 0, alpha0)
}
OE_true <- function(PO, alpha1, alpha0) {
y.bar.margin(PO, alpha1) - y.bar.margin(PO, alpha0)
}
get_est_vec <- function(estimates) {
DE <- subset(estimates, effect == "direct" & trt1 == 1)
IE <- subset(estimates, effect == "indirect" & trt1 == 0)
TE <- subset(estimates, effect == "total")
OE <- subset(estimates, effect == "overall")
c(
subset(DE, alpha1 == 0.25)$estimate,
subset(DE, alpha1 == 0.50)$estimate,
subset(DE, alpha1 == 0.75)$estimate,
subset(IE, alpha1 == 0.25 & alpha2 == 0.50)$estimate,
subset(IE, alpha1 == 0.50 & alpha2 == 0.75)$estimate,
subset(IE, alpha1 == 0.25 & alpha2 == 0.75)$estimate,
subset(TE, trt1 == 1 & alpha1 == 0.25 & alpha2 == 0.50)$estimate,
subset(TE, trt1 == 1 & alpha1 == 0.50 & alpha2 == 0.75)$estimate,
subset(TE, trt1 == 1 & alpha1 == 0.25 & alpha2 == 0.75)$estimate,
subset(OE, alpha1 == 0.25 & alpha2 == 0.50)$estimate,
subset(OE, alpha1 == 0.50 & alpha2 == 0.75)$estimate,
subset(OE, alpha1 == 0.25 & alpha2 == 0.75)$estimate
)
}
## precompute neighborhoods once
nn_idx <- lapply(seq_len(n), function(i) {
which(data$id %in% igraph::neighborhood(net0, order = 1, nodes = i)[[1]])
})
nb_idx <- lapply(seq_len(n), function(i) {
which(data$id %in% igraph::neighbors(net0, i))
})
nn_group_ids <- lapply(nn_idx, function(idx) data$id[idx])
nn_len_sqrt <- sqrt(vapply(nn_idx, length, integer(1)))
true_list <- vector("list", n_sim)
sim_list  <- vector("list", n_sim)
boot_list <- if (return_boot) vector("list", n_sim) else NULL
sim_count <- 0
start_time <- Sys.time()
while (sim_count < n_sim) {
tryCatch({
data_iter <- data
## generate potential outcomes
na <- data_iter$na + 1
data_iter$L <- rbinom(n, 1, 0.5)
outcomes.matrix.list <- vector("list", n)
for (i in seq_len(n)) {
outcomes.matrix.list[[i]] <- matrix(NA, nrow = 2, ncol = na[i])
}
for (i in seq_len(n)) {
for (a in 1:2) {
for (k in seq_len(na[i])) {
alpha.avg <- (k - 1) / data_iter$na[i]
p <- plogis(
intercept +
beta.a * (a - 1) +
(beta.a.alpha * alpha.avg) * (a - 1) +
beta.alpha * alpha.avg +
beta.l * data_iter$L[i]
)
outcomes.matrix.list[[i]][a, k] <- rbinom(1, 1, prob = p)
}
}
}
## individual random effects and exposure model
data_iter$ind_eff <- rnorm(n, mean = 0, sd = 2)
data_iter$nn_eff <- vapply(seq_len(n), function(i) {
sum(data_iter$ind_eff[nn_idx[[i]]]) / nn_len_sqrt[i]
}, numeric(1))
data_iter$A <- rbinom(
n, 1,
plogis(propensity.intercept + propensity.L * data_iter$L + data_iter$nn_eff)
)
na_a <- integer(n)
y <- numeric(n)
for (i in seq_len(n)) {
a <- sum(data_iter$A[nb_idx[[i]]])
na_a[i] <- a
s <- data_iter$A[i] + 1
t <- a + 1
y[i] <- outcomes.matrix.list[[i]][s, t]
}
data_iter$na_a <- na_a
data_iter$y <- y
## build neighborhood data
nn_data_list <- lapply(seq_len(n), function(i) {
sub <- data_iter[nn_idx[[i]], , drop = FALSE]
sub$group <- i
sub
})
nn_data <- do.call(rbind, nn_data_list)
rownames(nn_data) <- NULL
M1 <- interference(
formula = y | A ~ L + (1 | group) | group,
allocations = allocations,
data = nn_data,
randomization = randomization,
method = method,
model_method = model_method
)
est_vec <- get_est_vec(M1$estimates)
if (is.na(est_vec[1])) stop("ERROR")
true_vec <- c(
DE_true(outcomes.matrix.list, 0.25),
DE_true(outcomes.matrix.list, 0.5),
DE_true(outcomes.matrix.list, 0.75),
IE_true(outcomes.matrix.list, 0.25, 0.5),
IE_true(outcomes.matrix.list, 0.5, 0.75),
IE_true(outcomes.matrix.list, 0.25, 0.75),
TE_true(outcomes.matrix.list, 0.25, 0.5),
TE_true(outcomes.matrix.list, 0.5, 0.75),
TE_true(outcomes.matrix.list, 0.25, 0.75),
OE_true(outcomes.matrix.list, 0.25, 0.5),
OE_true(outcomes.matrix.list, 0.5, 0.75),
OE_true(outcomes.matrix.list, 0.25, 0.75)
)
sim_count <- sim_count + 1
true_list[[sim_count]] <- true_vec
sim_list[[sim_count]] <- est_vec
if (verbose) message("Successful simulation: ", sim_count, "/", n_sim)
## bootstrap
if (return_boot) {
nn_groups <- split(nn_data, nn_data$group)
single_boot <- vector("list", n_boot)
boot_count <- 0
while (boot_count < n_boot) {
tryCatch({
S <- sample(seq_len(n), boot_n, replace = TRUE)
boot_ids <- unlist(nn_group_ids[S], use.names = FALSE)
boot_frames <- nn_groups[as.character(boot_ids)]
for (ii in seq_along(boot_frames)) {
boot_frames[[ii]]$boot_group <- ii
}
boot <- do.call(rbind, boot_frames)
rownames(boot) <- NULL
M2 <- interference(
formula = y | A ~ L + (1 | boot_group) | boot_group,
allocations = allocations,
data = boot,
randomization = randomization,
method = method,
model_method = model_method
)
b_est_vec <- get_est_vec(M2$estimates)
if (is.na(b_est_vec[1])) stop("ERROR")
boot_count <- boot_count + 1
single_boot[[boot_count]] <- b_est_vec
if (verbose) {
message("  Bootstrap: ", boot_count, "/", n_boot,
" (simulation ", sim_count, ")")
}
}, error = function(e) {
if (verbose) {
message("  Bootstrap ERROR: ", conditionMessage(e))
}
})
}
boot_list[[sim_count]] <- do.call(rbind, single_boot)
}
}, error = function(e) {
if (verbose) {
message("Simulation ERROR: ", conditionMessage(e))
}
})
}
end_time <- Sys.time()
true_val <- as.data.frame(do.call(rbind, true_list))
sim_val  <- as.data.frame(do.call(rbind, sim_list))
names(true_val) <- est_names
names(sim_val) <- est_names
if (return_boot) {
boot_val <- as.data.frame(do.call(rbind, boot_list))
names(boot_val) <- est_names
} else {
boot_val <- NULL
}
estimate <- data.frame(
true = apply(true_val, 2, mean),
sim  = apply(sim_val, 2, mean),
ESE  = apply(sim_val, 2, sd)
)
estimate$bias <- estimate$true - estimate$sim
out <- list(
true_val = true_val,
sim_val = sim_val,
boot_val = boot_val,
estimate = estimate,
elapsed_time = end_time - start_time
)
return(out)
}
